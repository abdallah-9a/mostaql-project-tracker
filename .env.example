# ---- Required ----------------------------------------------------------
# Bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Target chat: a numeric user ID (e.g. 123456789) or a channel/group
# username (e.g. @my_channel). For groups, add the bot first and use the
# negative numeric ID (e.g. -1001234567890).
CHAT_ID=123456789

# ---- Optional ----------------------------------------------------------
# Where DOM-breakage admin alerts go. Falls back to CHAT_ID when unset.
ADMIN_CHAT_ID=

# Optional: route Mostaql fetches through ScraperAPI to bypass cloud WAF blocks.
# Leave blank to fetch Mostaql directly.
SCRAPER_API_KEY=

# On the very first run the monitor normally marks all currently-listed
# projects as "seen" without alerting, so a cold start does not spam you
# with ~25 notifications. Set to true to receive that initial batch.
NOTIFY_ON_FIRST_RUN=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
